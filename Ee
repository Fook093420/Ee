-- 4. ระบบเดินอัปเกรดตัวป้อนเฉพาะในฟาร์ม (พร้อมดีเลย์ปลอดภัยกันเด้ง)
Tab:CreateToggle({
   Name = "เดินอัปเกรดตัวป้อน (Safe Mode: ดีเลย์กันแบน)",
   CurrentValue = false,
   Callback = function(Value)
      _G.SmartFeederUpgrade = Value
      task.spawn(function()
         while _G.SmartFeederUpgrade do
            pcall(function()
               local character = LocalPlayer.Character
               local humanoid = character and character:FindFirstChildOfClass("Humanoid")
               local rootPart = character and character:FindFirstChild("HumanoidRootPart")

               if humanoid and rootPart then
                  local basePos = rootPart.Position

                  for _, obj in ipairs(workspace:GetDescendants()) do
                     if not _G.SmartFeederUpgrade then break end
                     
                     if obj:IsA("ProximityPrompt") then
                        if obj.Parent and obj.Parent:IsA("BasePart") then
                           local targetPart = obj.Parent
                           local distance = (targetPart.Position - basePos).Magnitude
                           
                           -- จำกัดรัศมีเฉพาะในฟาร์มตัวเอง (ไม่เกิน 25 เมตร)
                           if distance <= 25 then
                              humanoid:MoveTo(targetPart.Position)
                              
                              -- รอจนกว่าตัวละครจะเดินถึงจุด
                              local startTime = tick()
                              repeat
                                 task.wait(0.2)
                                 if not _G.SmartFeederUpgrade then break end
                                 if tick() - startTime > 3 then break end
                              until (rootPart.Position - targetPart.Position).Magnitude < 5 or not humanoid
                              
                              -- กดปุ่ม 1 ครั้ง เพื่อความปลอดภัย
                              pcall(function()
                                 fireproximityprompt(obj)
                              end)
                              
                              -- ดีเลย์หน่วงเวลา 6 วินาทีก่อนไปปุ่มถัดไป (กันโดนระบบตรวจจับว่าสแปม)
                              task.wait(6)
                           end
                        end
                     end
                  end
               end
            end)
            task.wait(2)
         end
      end)
   end
})

-- 5. ระบบ AFK + จอมืดประหยัดแบตเตอรี่
Tab:CreateToggle({
   Name = "เปิดระบบ AFK + จอมืด",
   CurrentValue = false,
   Callback = function(Value)
      _G.AFKMode = Value
      blackScreenGui.Enabled = Value
      
      if Value then
         local connection
         connection = LocalPlayer.Idled:Connect(function()
            if _G.AFKMode then
               VirtualUser:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
               task.wait(1)
               VirtualUser:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
            else
               connection:Disconnect()
            end
         end)
      end

      task.spawn(function()
         while _G.AFKMode do
            pcall(function() setfpscap(15) end)
            task.wait(10)
         end
         pcall(function() setfpscap(60) end)
      end)
   end
})

